# ============================================================
# SunanddriveOS — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env
# ============================================================

# Base de données master
DATABASE_MASTER_URL=postgresql://sunanddriveos:CHANGE_ME@db-master:5432/sunanddriveos_master
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT — générer avec : openssl rand -base64 64
JWT_SECRET=CHANGE_ME_64_CHARS_MIN
JWT_EXPIRES_IN=7d

# Anthropic Claude (backend uniquement — jamais côté frontend)
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Email transactionnel (invitations, alertes)
SMTP_FROM="SunanddriveOS <noreply@sunanddrive.fr>"

# URLs application
# IMPORTANT : inclure le port si différent de 80/443 (ex: :8080 pour NAS)
FRONTEND_URL=http://192.168.1.111:8080
BACKEND_URL=http://192.168.1.111:8080/api/v1
NODE_ENV=production
PORT=4000

# Cloudflare Tunnel — pour webhooks Getaround en temps réel
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME
CLOUDFLARE_PUBLIC_DOMAIN=sunanddriveos.CHANGE_ME.trycloudflare.com

# Getaround webhooks — générer avec : openssl rand -hex 32
GETAROUND_WEBHOOK_SECRET=CHANGE_ME_HEX_32

# Stripe — abonnements SaaS
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# Chiffrement des clés API tenant (AES-256)
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_BASE64_32

# Telegram Bot — alertes temps réel (réservations, carburant, CT, sièges auto)
# Créer un bot via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=

# Uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_PATH=/app/uploads
