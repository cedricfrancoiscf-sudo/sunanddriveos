# ─── Base de données ──────────────────────────────────────────────────────────
# URL PostgreSQL de la base master (tenants, plans, superadmins)
DATABASE_MASTER_URL=postgresql://sunanddriveos:PASSWORD@localhost:5432/sunanddriveos_master

# Mot de passe par défaut des bases tenant (utilisé dans init.ts pour créer sun-and-drive)
DB_PASSWORD=sunanddriveos

# ─── Authentification ─────────────────────────────────────────────────────────
# Secret JWT — minimum 32 caractères, générer avec : openssl rand -hex 32
JWT_SECRET=change-me-minimum-32-chars-long-secret-key
JWT_EXPIRES_IN=7d

# ─── Chiffrement ─────────────────────────────────────────────────────────────
# Clé AES-256 pour chiffrer les clés API Getaround — 32 bytes en hex (64 chars)
# Générer avec : openssl rand -hex 32
ENCRYPTION_KEY=change-me-64-hex-chars-long-encryption-key-for-aes256

# ─── IA Anthropic (Claude) ────────────────────────────────────────────────────
# Clé API Anthropic pour Claude Sonnet — suggestions messages, copilote, rapport CEO
ANTHROPIC_API_KEY=sk-ant-...

# ─── Stripe (Paiements SaaS) ──────────────────────────────────────────────────
# Laisser vide pour désactiver Stripe (abonnement géré manuellement)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs pour les plans (optionnel si prix dynamiques via PlanConfig)
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_YEARLY_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_...
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_...
# Anciens price IDs (deprecated — utiliser PlanConfig à la place)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ─── Emails (Resend) ──────────────────────────────────────────────────────────
# Clé API Resend pour l'envoi d'emails transactionnels
RESEND_API_KEY=re_...
# Adresse d'expédition (doit être vérifiée dans Resend)
RESEND_FROM=contact@sunanddrive.fr

# ─── Telegram (notifications carkeeper) ──────────────────────────────────────
# Token du bot Telegram pour les notifications terrain
TELEGRAM_BOT_TOKEN=
# Chat ID du canal de notifications (optionnel — configuré par tenant)
TELEGRAM_CHAT_ID=

# ─── APIs externes ────────────────────────────────────────────────────────────
# Clé API Getaround (optionnel — chaque tenant configure la sienne dans l'interface)
GETAROUND_API_KEY=
# Secret de signature webhook Getaround (non utilisé en self-service)
GETAROUND_WEBHOOK_SECRET=
# Clé API Autobiz pour estimation valeur véhicule (optionnel)
AUTOBIZ_API_KEY=

# ─── Serveur ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
# URL du frontend (pour les redirections Stripe, emails de bienvenue)
FRONTEND_URL=https://appli.sunanddrive.com
# URL publique Cloudflare — préfixe les URLs des uploads (logos, photos véhicules)
PUBLIC_URL=https://appli.sunanddrive.com
# URL de l'API backend (utilisée en interne)
BACKEND_URL=http://localhost:3001
API_BASE_URL=https://appli.sunanddrive.com/api/v1

# ─── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=/uploads
UPLOAD_PATH=/uploads
UPLOAD_MAX_SIZE_MB=10
