// Schéma base master — companies, super_admins, billing_events
// Une seule base master pour toutes les sociétés

generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/master"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_MASTER_URL")
}

// Plan d'abonnement SaaS
enum Plan {
  starter
  pro
  enterprise
}

// Société cliente de SunanddriveOS
model Company {
  id                   String         @id @default(cuid())
  name                 String
  slug                 String         @unique // Identifiant URL-safe, sert de nom DB tenant
  logoUrl              String?
  primaryColor         String         @default("#01696e")
  secondaryColor       String         @default("#04292a")
  plan                 Plan           @default(starter)
  stripeCustomerId     String?        @unique
  stripeSubscriptionId String?        @unique
  tenantDbUrl          String         // URL base de données tenant chiffrée
  icalToken            String?        @unique // Token public lien iCal accessoires
  isActive             Boolean        @default(true)
  trialEndsAt          DateTime?
  siret                String?
  managerName          String?
  phone                String?
  contactEmail         String?
  address              String?
  city                 String?
  postalCode           String?
  subscriptionStatus   String         @default("active") // active | suspendu | résilié
  subscriptionMode     String         @default("standard") // standard | trial | forced
  subscriptionStartedAt DateTime?
  forcedPrice          Float?
  commercialNote       String?
  onboardingCompleted  Boolean        @default(false)
  onboardingStep       Int            @default(1)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  billingEvents        BillingEvent[]
  tenantEvents         TenantEvent[]
  tenantFeedbacks      TenantFeedback[]
  tenantNotes          TenantNote[]
  npsResponses         NpsResponse[]
  lastNpsAt            DateTime?

  @@map("companies")
}

// Super administrateur global (accès toutes sociétés)
model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("super_admins")
}

// Événements d'usage par module (tracking analytics)
model TenantEvent {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module     String
  action     String
  occurredAt DateTime @default(now())

  @@index([companyId, occurredAt])
  @@map("tenant_events")
}

// Remontées tenants (bug, feature, feedback)
model TenantFeedback {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  type        String   // bug | feature | feedback
  title       String
  description String
  status      String   @default("new") // new | in_progress | done | rejected
  submittedAt DateTime @default(now())

  @@map("tenant_feedbacks")
}

// Configuration des plans tarifaires
model PlanConfig {
  id           String   @id @default(cuid())
  name         String   @unique // starter | pro | enterprise
  priceMonthly Float    @default(0)
  priceYearly  Float    @default(0)
  description  String   @default("")
  features     Json     @default("[]")
  isActive     Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@map("plan_configs")
}

// Notes internes superadmin sur un tenant
model TenantNote {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  content   String
  createdBy String   @default("superadmin")
  createdAt DateTime @default(now())

  @@map("tenant_notes")
}

// Réponses NPS (Net Promoter Score)
model NpsResponse {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  score       Int
  comment     String?
  respondedBy String?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("nps_responses")
}

// Configuration système superadmin (clé/valeur)
model SuperAdminConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("superadmin_configs")
}

// Événements de facturation Stripe
model BillingEvent {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          String   // subscription_created, payment_succeeded, payment_failed, etc.
  stripeEventId String   @unique
  data          Json
  processedAt   DateTime @default(now())

  @@map("billing_events")
}
