// Schéma base tenant — données opérationnelles par société
// Une base indépendante par société (slug = nom de la DB)

generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/tenant"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_TENANT_URL")
}

enum UserRole {
  admin
  exploitation
  comptable
  carkeeper
  third_party_owner
}

enum RentalStatus {
  booked
  active
  completed
  cancelled
}

enum EvaluationStatus {
  pending
  posted
  blocked
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageStatus {
  pending_approval
  approved
  sent
  cancelled
}

enum CheckResult {
  pass
  advisory
  fail
}

enum SequenceStatus {
  pending
  sent
  cancelled
}

enum DocumentType {
  insurance
  registration
  lease
  technical_control
  other
}

enum IncidentType {
  damage
  theft
  accident
  vandalism
  other
}

enum IncidentStatus {
  open
  in_progress
  resolved
  closed
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  passwordHash     String?
  name             String
  role             UserRole
  roles            String[]            @default([]) // rôles multiples : ["admin", "carkeeper"]
  isActive         Boolean             @default(true)
  invitationToken  String?             @unique
  invitationExpiry DateTime?
  resetToken       String?             @unique
  resetExpiry      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  thirdPartyOwner  ThirdPartyOwner?
  notifications    Notification[]
  vehicleChecks    VehicleCheck[]
  approvedMessages Message[]           @relation("ApprovedBy")
  vehicleCarkeepers VehicleCarkeeper[]
  vehiclesAsCarkeeper    Vehicle[]     @relation("VehiclePrimaryCarkeeper")
  accessoriesAsCarkeeper Accessory[]   @relation("AccessoryCarkeeper")
  carSeatsAsCarkeeper    CarSeat[]     @relation("CarSeatCarkeeper")

  @@map("users")
}

model GetaroundAccount {
  id               String    @id @default(cuid())
  name             String    // Libellé du compte (ex: "Compte principal", "Compte Lyon")
  apiKeyHash       String    // Clé API chiffrée AES-256
  isActive         Boolean   @default(true)
  lastSyncAt       DateTime?
  syncStatus       String?   // success | error | syncing
  syncError        String?
  accountStartDate DateTime? // Date de création du compte Getaround du propriétaire
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  vehicles         Vehicle[]

  @@map("getaround_accounts")
}

model Vehicle {
  id                 String            @id @default(cuid())
  getaroundId        String?           @unique
  getaroundAccountId String?
  getaroundAccount   GetaroundAccount? @relation(fields: [getaroundAccountId], references: [id])
  licensePlate       String
  make               String
  model              String
  year               Int
  color              String?
  photoUrl           String?
  fuelType           String?           // essence | diesel | electrique | hybride | gpl
  parkingZone        String?           // Zone de stationnement (ex: "Zone A - Parking Nord")
  deliveryPointName  String?           // Nom du point de livraison (ex: "Parking Mignet")
  deliveryPostalCode String?           // Code postal du point de livraison
  pickupInstructions String?           // Instructions de départ : adresse, code, boîte à clé...
  returnInstructions String?           // Instructions de retour : où garer, clés, carburant...
  critAir            String?           // "0"|"1"|"2"|"3"|"4"|"5"|"NC"
  purchasePrice      Float?            // Prix d'achat TTC
  purchaseDate       DateTime?         // Date d'achat
  loanAmount         Float?            // Montant emprunté (€)
  loanRate           Float?            // Taux annuel (%)
  loanDurationMonths Int?              // Durée du prêt (mois)
  loanStartDate      DateTime?         // Date de début du prêt
  loanDeposit        Float?            // Apport personnel à l'achat (€) — null = 0
  marketValue        Float?            // Valeur de revente estimée (€) — saisie manuelle
  marketValueDate    DateTime?         // Date de la dernière estimation
  marketValueJ0      Float?            // Valeur de reprise pro au jour de l'achat (€)
  depreciationRate   Float?            // Pente mensuelle en €/mois (null = calibrée auto)
  currentMileage     Int               @default(0)
  healthScore        Int               @default(100)
  vehicleCategory    String            @default("tourisme") // "tourisme" | "utilitaire" | "camionnette"
  isActive           Boolean           @default(true)
  carekeeperUserId   String?
  carekeeperUser     User?             @relation("VehiclePrimaryCarkeeper", fields: [carekeeperUserId], references: [id])
  thirdPartyOwnerId  String?
  thirdPartyOwner    ThirdPartyOwner?  @relation(fields: [thirdPartyOwnerId], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  rentals            Rental[]
  maintenances       Maintenance[]
  maintenanceTasks   MaintenanceTask[]
  vehicleChecks      VehicleCheck[]
  documents          VehicleDocument[]
  incidents          Incident[]
  blockings          Blocking[]
  unavailabilities   Unavailability[]
  accessories           AccessoryVehicle[]
  carSeatRequests       CarSeatRequest[]
  accessoryReservations AccessoryReservation[]
  carkeepers            VehicleCarkeeper[]
  photos                VehiclePhoto[]
  ratings               VehicleRating[]
  costs                 VehicleCost[]
  objectives            VehicleObjective[]
  valuations            VehicleValuation[]
  warranty              VehicleWarranty?

  @@map("vehicles")
}

model VehiclePhoto {
  id           String    @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  filename     String
  url          String
  uploadedAt   DateTime  @default(now())
  uploadedById String?
  isCover      Boolean   @default(false)
  latitude     Float?
  longitude    Float?
  accuracy     Float?
  takenAt      DateTime?
  deviceInfo   String?

  @@map("vehicle_photos")
}

model Rental {
  id                  String              @id @default(cuid())
  getaroundId         String              @unique
  vehicleId           String
  vehicle             Vehicle             @relation(fields: [vehicleId], references: [id])
  driverName          String
  driverEmail         String?
  driverGetaroundId   String?
  startAt             DateTime
  endAt               DateTime
  startMileage        Int?
  endMileage          Int?
  kmDriven            Int?                // endMileage - startMileage (calculé)
  grossRevenue        Float?              // CA brut facturé locataire
  ownerPayout         Float?              // Virement propriétaire
  // Décomposition CA depuis les charges Getaround
  basePrice           Float?              // driver_rental_payment — prix de base location
  extraDistanceFee    Float?              // extra_distance_payment — frais km supplémentaires
  insuranceFee        Float?              // self_insurance_payment + additional_self_insurance_payment
  assistanceFee       Float?              // assistance_fee — assistance routière
  deliveryFee         Float?              // delivery_fee — frais livraison
  driverMessFee       Float?              // Frais messagerie → bloquer évaluation
  damageCompensation  Float?              // Compensation dommage → créer incident
  gasRefillFee        Float?              // Frais carburant → noter
  lateReturnFee       Float?              // Frais retard → noter
  // Champs manquants v1.json — ajoutés pour mapping complet des charges
  batteryRechargeFee   Float?             // battery_recharge_compensation + rental_recharging_compensation
  ownerInfractionFee   Float?             // owner_infraction_compensation + driver_infraction_fee + tolls + parking
  ownerTowFee          Float?             // owner_tow_compensation
  guaranteeEarning     Float?             // guarantee_earning
  otherCompensation    Float?             // other_compensation + exceptional_event_compensation + misc
  getaroundServiceFee  Float?             // drivy_service_fee (négatif — commission Getaround)
  repatriationFee      Float?             // repatriation_fee
  cancellationFee      Float?             // driver_cancellation_fee + drivy_cancellation_fee
  status              RentalStatus        @default(booked)
  cancellationReason  String?             // annulation_locataire | annulation_proprio | no_show | litige | sans_suite
  isTest              Boolean             @default(false)
  evaluationStatus    EvaluationStatus    @default(pending)
  evaluationRating    Int?
  evaluationComment   String?
  invoiceData         Json?               // Données brutes facture Getaround
  fuelLevelCheckin    Float?              // Niveau carburant check-in (0-100)
  fuelLevelCheckout   Float?              // Niveau carburant check-out (0-100)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  messages            Message[]
  sequenceExecutions  SequenceExecution[]
  incidents             Incident[]
  carSeatRequests       CarSeatRequest[]
  accessoryReservations AccessoryReservation[]
  invoices              GetaroundInvoice[]
  invoicesSyncedAt            DateTime?
  evaluationFlag              String?   // blocked_cleaning | blocked_damage | blocked_claim | blocked_late | blocked_infraction | blocked_gas
  evaluationFlagAmount        Int?      // Montant en centimes
  evaluationFlagUnblockedAt   DateTime?
  evaluationFlagUnblockedById String?
  rentalInvoices              RentalInvoice[]

  @@map("rentals")
}

model Message {
  id           String           @id @default(cuid())
  getaroundId  String?          @unique
  rentalId     String
  rental       Rental           @relation(fields: [rentalId], references: [id])
  direction    MessageDirection
  content      String
  sentAt       DateTime?
  aiAnalysis   Json?            // Détection siège auto, sinistre, insatisfaction
  aiSuggestion String?          // Réponse générée par Claude
  status       MessageStatus    @default(pending_approval)
  approvedById String?
  approvedBy   User?            @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  cancelledAt  DateTime?
  isTest       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("messages")
}

model MessageSequence {
  id           String              @id @default(cuid())
  name         String
  triggerEvent String              // rental.booked | rental.car_checked_in | rental.car_checked_out
  delayMinutes Int                 @default(0)
  content      String              // Template : {{driver_name}}, {{vehicle}}, {{start_date}}
  isActive     Boolean             @default(true)
  vehicleId    String?             // null = applicable à toute la flotte
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  executions   SequenceExecution[]

  @@map("message_sequences")
}

model SequenceExecution {
  id           String          @id @default(cuid())
  rentalId     String
  rental       Rental          @relation(fields: [rentalId], references: [id])
  sequenceId   String
  sequence     MessageSequence @relation(fields: [sequenceId], references: [id])
  scheduledAt      DateTime
  executedAt       DateTime?
  status           SequenceStatus  @default(pending)
  messageId        String?
  errorMessage     String?
  cancelledReason  String?
  createdAt        DateTime        @default(now())

  @@map("sequence_executions")
}

model Maintenance {
  id                 String           @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle          @relation(fields: [vehicleId], references: [id])
  maintenanceTaskId  String?
  maintenanceTask    MaintenanceTask? @relation(fields: [maintenanceTaskId], references: [id])
  type               String           // vidange | freins | pneus | courroie | filtres | autre | revision | ct
  performedAt        DateTime
  mileageAtService   Int
  nextServiceDate    DateTime?
  nextServiceMileage Int?
  intervalKm         Int?
  intervalMonths     Int?
  cost               Float?
  provider           String?
  notes              String?
  documentUrl        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("maintenances")
}

model MaintenanceTask {
  id               String        @id @default(cuid())
  vehicleId        String
  vehicle          Vehicle       @relation(fields: [vehicleId], references: [id])
  type             String        // "revision" | "ct"
  lastPerformedAt  DateTime?
  lastMileage      Int?
  lastCost         Float?
  lastProvider     String?
  lastNotes        String?
  nextDueDate      DateTime?
  nextDueMileage   Int?
  intervalKm             Int?      // null pour CT (temporel seulement)
  intervalMonths         Int?      // 12 pour revision, 24 pour CT tourisme
  ctResult               String?   // "favorable" | "defavorable" | "contre_visite"
  ctCounterVisitDeadline DateTime? // performedAt + 2 mois si défavorable
  totalCost              Float     @default(0)
  occurrenceCount  Int           @default(0)
  history          Maintenance[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([vehicleId, type])
  @@map("maintenance_tasks")
}

model VehicleCheck {
  id             String      @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle     @relation(fields: [vehicleId], references: [id])
  checkedById    String
  checkedBy      User        @relation(fields: [checkedById], references: [id])
  checkedAt      DateTime
  status         String      @default("draft") // draft | completed | synced
  // 9 sections exactes de la fiche contrôle Sun and Drive
  lighting       Json        // 7 points éclairage
  levels         Json        // 5 niveaux liquides
  glazingMirrors Json        // 5 vitrages et rétroviseurs
  wipers         Json        // 3 essuie-glaces
  tires          Json        // 4 pneumatiques
  braking        Json        // 3 freinage
  engineBattery  Json        // 5 moteur et batterie
  safety         Json        // 5 sécurité
  roadTest       Json        // 4 essai routier
  fuelLevel      Int?        // Niveau carburant 0-100% au contrôle
  mileage        Int?        // Kilométrage au contrôle
  notes          String?
  photos         Json        @default("[]") // URLs photos smartphone
  overallResult  CheckResult @default(pass)
  isSynced       Boolean     @default(false) // Synchronisé depuis IndexedDB hors ligne
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("vehicle_checks")
}

model VehicleDocument {
  id           String       @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])
  type         DocumentType
  name         String
  fileUrl      String
  expiryDate   DateTime?
  reminderDays Int          @default(30) // Alerte X jours avant expiration
  isExpired    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("vehicle_documents")
}

model Incident {
  id                 String         @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle        @relation(fields: [vehicleId], references: [id])
  rentalId           String?
  rental             Rental?        @relation(fields: [rentalId], references: [id])
  type               IncidentType
  description        String
  status             IncidentStatus @default(open)
  cost               Float?
  insuranceReference String?
  photos             Json           @default("[]")
  resolution         String?
  resolvedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("incidents")
}

model Blocking {
  id                        String   @id @default(cuid())
  vehicleId                 String
  vehicle                   Vehicle  @relation(fields: [vehicleId], references: [id])
  getaroundUnavailabilityId String?  @unique
  startAt                   DateTime
  endAt                     DateTime
  reason                    String?
  type                      String   // maintenance | incident | administrative | other
  createdById               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("blockings")
}

model Unavailability {
  id             String   @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id])
  getaroundCarId Int
  getaroundId    String   @unique
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("unavailabilities")
}

model Accessory {
  id               String               @id @default(cuid())
  name             String
  description      String?
  quantity         Int                  @default(1)
  carekeeperUserId String?
  carkeeperId      String?
  carkeeper        User?                @relation("AccessoryCarkeeper", fields: [carkeeperId], references: [id])
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  vehicles         AccessoryVehicle[]
  reservations     AccessoryReservation[]

  @@map("accessories")
}

model AccessoryVehicle {
  vehicleId   String
  accessoryId String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  accessory   Accessory @relation(fields: [accessoryId], references: [id])
  assignedAt  DateTime  @default(now())

  @@id([vehicleId, accessoryId])
  @@map("accessory_vehicles")
}

model AccessoryReservation {
  id          String    @id @default(cuid())
  accessoryId String
  accessory   Accessory @relation(fields: [accessoryId], references: [id])
  rentalId    String
  rental      Rental    @relation(fields: [rentalId], references: [id])
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  status      String    @default("pending") // pending | confirmed | returned | cancelled
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("accessory_reservations")
}

model CarSeat {
  id             String           @id @default(cuid())
  name           String           // ex: "Groupe 0+ (0-13 kg)"
  minWeightKg    Float            // Poids minimum enfant supporté
  maxWeightKg    Float            // Poids maximum enfant supporté
  totalStock     Int              @default(0)
  availableStock Int              @default(0)
  outOfService   Int              @default(0)
  isActive       Boolean          @default(true)
  carkeeperId    String?
  carkeeper      User?            @relation("CarSeatCarkeeper", fields: [carkeeperId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  requests       CarSeatRequest[]

  @@map("car_seats")
}

model CarSeatRequest {
  id            String    @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id])
  rentalId      String?
  rental        Rental?   @relation(fields: [rentalId], references: [id])
  carSeatId     String?
  carSeat       CarSeat?  @relation(fields: [carSeatId], references: [id])
  childWeightKg Float?    // Poids de l'enfant en kg
  requestedAt   DateTime  @default(now())
  status        String    @default("pending") // pending | confirmed | denied | returned
  notes         String?
  isTest        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("car_seat_requests")
}

model RenterBlacklist {
  id                String   @id @default(cuid())
  driverGetaroundId String   @unique
  driverName        String
  reason            String
  blacklistedAt     DateTime @default(now())
  createdAt         DateTime @default(now())

  @@map("renter_blacklists")
}

model VehicleCarkeeper {
  id         String   @id @default(cuid())
  vehicleId  String
  userId     String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([vehicleId, userId])
  @@map("vehicle_carkeepers")
}

model ThirdPartyOwner {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  name            String
  email           String
  phone           String?
  contractDetails Json?
  paymentDetails  Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  vehicles        Vehicle[]

  @@map("third_party_owners")
}

model Notification {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  type              String   // ct_expiry | maintenance_due | message_received | blocking_requested
  title             String
  body              String
  isRead            Boolean  @default(false)
  relatedEntityType String?  // vehicle | rental | maintenance | technical_control
  relatedEntityId   String?
  targetUrl         String?  // ex: "/rentals/abc123", "/settings#getaround"
  createdAt         DateTime @default(now())

  @@map("notifications")
}

model VehicleRating {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  rating      Float
  reviewCount Int      @default(0)
  period      String   // format "YYYY-MM"
  keywords    String[]
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([vehicleId, period])
  @@map("vehicle_ratings")
}

model GetaroundInvoice {
  id          String   @id @default(cuid())
  getaroundId Int      @unique
  pdfUrl      String?
  totalPrice  Int
  currency    String   @default("EUR")
  emittedAt   DateTime?
  rentalId    String?
  rental      Rental?  @relation(fields: [rentalId], references: [id])

  @@map("getaround_invoices")
}

model VehicleCost {
  id                 String    @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  label              String
  amount             Float
  type               String    @default("fixed") // fixed | onetime
  amortizationMonths Int?      // si onetime, sur combien de mois amortir
  startDate          DateTime  @default(now())
  endDate            DateTime? // null = en cours
  createdAt          DateTime  @default(now())

  @@map("vehicle_costs")
}

model RentalInvoice {
  id                 String    @id @default(cuid())
  rentalId           String
  rental             Rental    @relation(fields: [rentalId], references: [id])
  getaroundInvoiceId Int
  chargeType         String
  amountCentimes     Int
  currency           String    @default("EUR")
  emittedAt          DateTime?
  createdAt          DateTime  @default(now())

  @@unique([rentalId, getaroundInvoiceId, chargeType])
  @@map("rental_invoices")
}

model GetaroundPayout {
  id          String   @id @default(cuid())
  getaroundId Int      @unique
  amount      Int
  currency    String   @default("EUR")
  completedAt DateTime?

  @@map("getaround_payouts")
}

model CompanySettings {
  id                   String   @id @default(cuid())
  primaryColor         String   @default("#01696e")
  secondaryColor       String   @default("#04292a")
  accentColor          String   @default("#0199a1")
  logoUrl              String?
  // Mode IA par type de message : auto | approval | manual
  aiModeCarSeat        String   @default("approval")
  aiModeIncident       String   @default("manual")
  aiModeGeneral        String   @default("approval")
  aiTone               String   @default("vouvoiement")
  aiName               String   @default("Alex")
  fontFamily           String   @default("Montserrat") // Police Google Fonts configurable
  alertEmails          String[] @default([])   // Destinataires des alertes email
  replyToEmail         String?                 // Email de réponse affiché aux locataires
  senderName           String?                 // Nom affiché dans le champ "De"
  maintenancePolicies      Json     @default("{}")
  notificationSettings     Json     @default("{}")
  invoiceSyncWindowDays    Int      @default(7)
  invoiceActiveTypes       String[] @default(["blocked_cleaning","blocked_damage","blocked_claim","blocked_late","blocked_infraction","blocked_gas"])
  invoiceMalusConfig       Json     @default("{}")
  // Séquences
  minMessageInterval       Int      @default(60)    // minutes min entre deux messages au même locataire
  // Intelligence
  ratingDropThreshold      Float    @default(0.0)  // toute baisse par défaut (>0.3 etc.)
  underutilizationThreshold Float   @default(0.30) // 30% occupation
  underutilizationWeeks    Int      @default(4)     // analyser N dernières semaines
  riskScoreAlertThreshold  Int      @default(60)   // alerte si score risque > seuil
  riskWeightScore          Int      @default(40)   // pondération score locataire
  riskWeightFlags          Int      @default(30)   // pondération evaluationFlag
  riskWeightCancelled      Int      @default(20)   // pondération annulations
  riskWeightDelay          Int      @default(10)   // pondération délai réponse
  // Véhicule
  autobizApiKey            String?
  depreciationThreshold    Float    @default(0.10) // €/km seuil recommandation revente
  warrantyAlertDays        Int      @default(30)   // jours avant expiration garantie
  co2FactorEssence         Float    @default(120)  // gCO2/km
  co2FactorHybride         Float    @default(60)
  co2FactorElectrique      Float    @default(10)
  co2EquivalentArbre       Float    @default(10)   // kg CO2 absorbé par arbre/an
  // Comptabilité
  journalCode              String   @default("VT")
  compteLocationsProduit   String   @default("706100")
  compteCompensationsProduit String @default("706200")
  compteEntretienCharge    String   @default("615000")
  compteAssuranceCharge    String   @default("616000")
  compteParkingCharge      String   @default("613000")
  formatExportPreference   String   @default("fec")
  objectifSeuilAlerte      Int      @default(80)
  getaroundWebhookPath String?
  boitierConnectAmount Int?                       // Montant mensuel Boîtier Connect (€) — null = 25€ par défaut
  slackWebhookUrl      String?                    // Webhook Slack pour notifications Enterprise
  // Revente & Décote
  depreciationRateYear1     Float    @default(0.20) // Taux décote annuel année 1
  depreciationRateYear2     Float    @default(0.15) // Taux décote annuel année 2
  depreciationRateYear3     Float    @default(0.12) // Taux décote annuel année 3
  depreciationRateYears4to6 Float    @default(0.10) // Taux décote annuel années 4-6
  depreciationRateAfter6    Float    @default(0.08) // Taux décote annuel après 6 ans (occasion)
  majorMaintenanceCost      Float    @default(1500) // Coût entretien majeur estimé (€)
  majorMaintenanceKm        Int      @default(30000) // Kilométrage déclencheur entretien majeur
  roiAlertMonthsBefore      Int      @default(6)    // Seuil alerte "Revendre bientôt" (mois avant optimal)
  roiCaMoyenMois            Int      @default(5)    // Nb de mois complets pour calcul CA moyen ROI
  roiHorizonMonths          Int      @default(48)   // Horizon courbe ROI en mois (12–120)
  roiCoeffSaison            Json?                   // Profil saisonnier [jan..déc] (null = pas de profil)
  platformName              String?                 // Nom de la plateforme (ex: Getaround)
  platformCommissionRate    Float?                  // Taux commission plateforme (ex: 1.2544 = 25,44 %)
  kmDeclinCA              Int      @default(160000) // Km déclencheur déclin CA (Getaround)
  kmStopGA                Int      @default(200000) // Km limite GA (véhicule retiré de la plateforme)
  defaultDepreciationRate Float    @default(100)    // Pente €/mois par défaut si aucun snapshot disponible
  messageUnansweredMinutes  Int?                    // Délai avant alerte message sans réponse (null = 30 min)
  suggestionsCacheTtlHours  Int      @default(1)    // Durée cache suggestions IA (heures)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("company_settings")
}
model VehicleValuation {
  id             String   @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  estimatedValue Float
  source         String   @default("autobiz")
  evaluatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@map("vehicle_valuations")
}

model VehicleWarranty {
  id                   String    @id @default(cuid())
  vehicleId            String    @unique
  vehicle              Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  warrantyStartDate    DateTime?
  warrantyMonths       Int?
  warrantyExtension    Boolean   @default(false)
  warrantyExtensionEnd DateTime?
  warrantyTires        Boolean   @default(false)
  warrantyTiresEnd     DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("vehicle_warranties")
}

model VehicleObjective {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  month     String   // format YYYY-MM
  targetCA  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, month])
  @@map("vehicle_objectives")
}

model CeoReport {
  id          String    @id @default(cuid())
  companyId   String
  month       String
  mode        String    @default("annual")
  status      String    @default("generating")
  content     Json?
  generatedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([companyId, month, mode])
  @@map("ceo_reports")
}
